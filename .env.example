# Create a bot with @BotFather. Keep the real token only in your private .env.
BOT_TOKEN=replace_with_your_bot_token
DATABASE_PATH=data/nexora.sqlite3
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
# Optional declared durable root; DATABASE_PATH must resolve below it.
# Required on Render with a real mounted disk (not available on its Free plan).
# PERSISTENT_DATA_DIR=/var/lib/nexora
# PORT is accepted when HTTP_PORT is omitted. No PostgreSQL DATABASE_URL support.
# Public HTTPS origin, required for web CAPTCHA. No trailing slash or path.
PUBLIC_URL=
# A private staff group/supergroup. All members of this group can read tickets.
SUPPORT_CHAT_ID=0
# Numeric Telegram IDs allowed to reply/manage support, comma-separated.
SUPPORT_ADMIN_IDS=
# Separate global operator role for broadcast console; numeric IDs only, no usernames.
# Leave blank to disable super-admin broadcasts. Set privately; never grant via chat.
SUPER_ADMIN_IDS=
# Optional Cloudflare Turnstile integration. Exact registered hostname, no scheme.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAME=
# Event/analytics retention; persistent settings, tickets and scores are separate.
RETENTION_DAYS=90
# Optional automatic backups; use a private directory on durable storage, outside source.
NEXORA_BACKUP_DIR=
NEXORA_BACKUP_SECONDS=86400
NEXORA_BACKUP_KEEP=7
# Optional Ollama. Disabled by default; install/download a model separately.
NEXORA_AI_ENABLED=0
NEXORA_AI_URL=http://127.0.0.1:11434
NEXORA_AI_MODEL=
# Remote endpoints require this AND group consent. May incur provider charges.
NEXORA_AI_ALLOW_EXTERNAL=0
# Stars prices pending owner selection. Never guess a dollar-to-Stars conversion.
# Pro: six group slots / three calendar months (one-time). Ultra: one group / 30 days.
# Enable limits only with a configured, available checkout. Existing data is preserved.
NEXORA_PLAN_LIMITS=0
NEXORA_BILLING_ENABLED=0
NEXORA_PRO_STARS=0
NEXORA_ULTRA_STARS=0
NEXORA_BILLING_TERMS=
